{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@veyra/ui": ["./packages/ui/src"],
      "@veyra/auth": ["./packages/auth/src"],
      "@veyra/memory": ["./packages/memory/src"],
      "@veyra/retrieval": ["./packages/retrieval/src"],
      "@veyra/agent-runtime": ["./packages/agent-runtime/src"],
      "@veyra/observability": ["./packages/observability/src"],
      "@veyra/sdk": ["./packages/sdk/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
