{
  "name": "@veyra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Veyra desktop app (Electron)",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "build:web": "npm run build:native --workspace=@veyra/web",
    "electron:dev": "cross-env VEYRA_DESKTOP_DEV=1 node ../../node_modules/electron/cli.js .",
    "start:prod": "npm run sync:web && node ../../node_modules/electron/cli.js .",
    "dev": "concurrently -k \"npm run dev --workspace=@veyra/web\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "pack": "npm run sync:web && npx electron-builder --dir",
    "dist": "npm run sync:web && npx electron-builder",
    "dist:win": "npm run sync:web && npx electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.veyra.desktop",
    "productName": "Veyra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Veyra-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
