{
  "name": "@veyra/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Veyra Android app (Capacitor)",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "build:web": "npm run build:native --workspace=@veyra/web",
    "cap:sync": "npm run sync:web && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.3.0"
  }
}