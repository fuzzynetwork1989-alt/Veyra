{
  "dashboard": {
    "title": "Veyra Platform Dashboard",
    "panels": [
      {
        "title": "API Request Rate",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "API Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Active Tasks",
        "targets": [
          {
            "expr": "veyra_tasks_active"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Task Completion Rate",
        "targets": [
          {
            "expr": "rate(veyra_tasks_completed_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "process_resident_memory_bytes"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Redis Connections",
        "targets": [
          {
            "expr": "redis_connected_clients"
          }
        ],
        "type": "stat"
      }
    ]
  }
}
