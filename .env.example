# Infrastructure
POSTGRES_USER=veyra
POSTGRES_PASSWORD=veyra_password_change_this
POSTGRES_DB=veyra
GRAFANA_ADMIN_PASSWORD=admin_change_this

# API (apps/api/.env)
DATABASE_URL=postgresql://veyra:veyra_password_change_this@localhost:5432/veyra
REDIS_URL=redis://localhost:6379
JWT_SECRET=veyra-secret-change-this
JWT_EXPIRES_MINUTES=60
REFRESH_TOKEN_DAYS=30
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=600
MOCK_LLM=0
DAILY_TOKEN_QUOTA=100000
DAILY_CHAT_QUOTA=500
DAILY_TASK_QUOTA=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github

# Worker (apps/worker/.env) — auto-loaded via dotenv
# REDIS_URL, DATABASE_URL, OPENAI_* as above
METRICS_PORT=8001
MOCK_LLM=0

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT_MS=300000

# Admin (apps/admin)
NEXT_PUBLIC_API_URL=http://localhost:8000