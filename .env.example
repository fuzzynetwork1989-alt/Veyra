# Infrastructure
POSTGRES_USER=veyra
POSTGRES_PASSWORD=veyra_password_change_this
POSTGRES_DB=veyra

# API (apps/api/.env)
DATABASE_URL=postgresql://veyra:veyra_password_change_this@localhost:5432/veyra
REDIS_URL=redis://localhost:6379
JWT_SECRET=veyra-secret-change-this
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=600
MOCK_LLM=0
DAILY_TOKEN_QUOTA=100000
DAILY_CHAT_QUOTA=500
DAILY_TASK_QUOTA=100

# Worker (apps/worker/.env)
# REDIS_URL and DATABASE_URL as above
# OPENAI_BASE_URL and OPENAI_API_KEY as above

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT_MS=300000

# Admin (apps/admin)
NEXT_PUBLIC_API_URL=http://localhost:8000